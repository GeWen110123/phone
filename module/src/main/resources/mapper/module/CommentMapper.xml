<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.phone.module.mapper.CommentMapper">
    
    <resultMap type="Comment" id="CommentResult">
        <result property="id"    column="id"    />
        <result property="uid"    column="uid"    />
        <result property="userUid"    column="user_uid"    />
        <result property="nickname"    column="nickname"    />
        <result property="gender"    column="gender"    />
        <result property="age"    column="age"    />
        <result property="realName"    column="real_name"    />
        <result property="signature"    column="signature"    />
        <result property="fansCount"    column="fans_count"    />
        <result property="followCount"    column="follow_count"    />
        <result property="likesCount"    column="likes_count"    />
        <result property="worksCount"    column="works_count"    />
        <result property="profileText"    column="profile_text"    />
        <result property="ipLocation"    column="ip_location"    />
        <result property="region"    column="region"    />
        <result property="touxiang"    column="touxiang"    />
        <result property="zhuye"    column="zhuye"    />
        <result property="commentText"    column="comment_text"    />
        <result property="replyTo"    column="reply_to"    />
        <result property="commentTime"    column="comment_time"    />
        <result property="status"    column="status"    />
        <result property="createTime"    column="create_time"    />
        <result property="userDouyin"    column="user_douyin"    />
    </resultMap>

    <sql id="selectCommentVo">
        select id, uid, user_douyin, user_uid, nickname, gender, age, real_name,
               signature, fans_count, follow_count, likes_count, works_count, profile_text, ip_location, region,
               touxiang, zhuye, comment_text, reply_to, comment_time, status, create_time from comment
    </sql>

    <select id="selectCommentList200" parameterType="Comment" resultMap="CommentResult">
        select id, uid, user_douyin from comment
        <where>
            user_douyin IS NULL
        </where>

        LIMIT 1000
    </select>


    <select id="selectCommentList" parameterType="Comment" resultMap="CommentResult">
        <include refid="selectCommentVo"/>
        <where>
            <if test="uid != null  and uid != ''"> and uid = #{uid}</if>
            <if test="userDouyin != null  and userDouyin != ''"> and user_douyin = #{userDouyin}</if>
            <if test="userUid != null  and userUid != ''"> and user_uid = #{userUid}</if>
            <if test="nickname != null  and nickname != ''"> and nickname like concat('%', #{nickname}, '%')</if>
            <if test="gender != null  and gender != ''"> and gender = #{gender}</if>
            <if test="age != null  and age != ''"> and age = #{age}</if>
            <if test="realName != null  and realName != ''"> and real_name like concat('%', #{realName}, '%')</if>
            <if test="signature != null  and signature != ''"> and signature = #{signature}</if>
            <if test="fansCount != null  and fansCount != ''"> and fans_count = #{fansCount}</if>
            <if test="followCount != null  and followCount != ''"> and follow_count = #{followCount}</if>
            <if test="likesCount != null  and likesCount != ''"> and likes_count = #{likesCount}</if>
            <if test="worksCount != null  and worksCount != ''"> and works_count = #{worksCount}</if>
            <if test="profileText != null  and profileText != ''"> and profile_text = #{profileText}</if>
            <if test="ipLocation != null  and ipLocation != ''"> and ip_location = #{ipLocation}</if>
            <if test="region != null  and region != ''"> and region = #{region}</if>
            <if test="touxiang != null  and touxiang != ''"> and touxiang = #{touxiang}</if>
            <if test="zhuye != null  and zhuye != ''"> and zhuye = #{zhuye}</if>
            <if test="commentText != null  and commentText != ''"> and comment_text = #{commentText}</if>
            <if test="replyTo != null  and replyTo != ''"> and reply_to = #{replyTo}</if>
            <if test="commentTime != null  and commentTime != ''"> and comment_time = #{commentTime}</if>
            <if test="status != null  and status != ''"> and status = #{status}</if>
        </where>
    </select>

    <select id="selectCommentListByUser" parameterType="Comment" resultMap="CommentResult">
        select user_douyin, user_uid from comment
        <where>
            <if test="userDouyin != null  and userDouyin != ''">and user_douyin = #{userDouyin}</if>
            <if test="userUid != null  and userUid != ''">and user_uid = #{userUid}</if>
            <if test="status != null  and status != ''">and status = #{status}</if>
        </where>
        group by user_douyin, user_uid
    </select>

    <select id="selectCommentById" parameterType="Long" resultMap="CommentResult">
        <include refid="selectCommentVo"/>
        where id = #{id}
    </select>
        
    <insert id="insertComment" parameterType="Comment" useGeneratedKeys="true" keyProperty="id">
        insert into comment
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="uid != null">uid,</if>
            <if test="userUid != null">user_uid,</if>
            <if test="userDouyin != null">user_douyin,</if>
            <if test="nickname != null">nickname,</if>
            <if test="gender != null">gender,</if>
            <if test="age != null">age,</if>
            <if test="realName != null">real_name,</if>
            <if test="signature != null">signature,</if>
            <if test="fansCount != null">fans_count,</if>
            <if test="followCount != null">follow_count,</if>
            <if test="likesCount != null">likes_count,</if>
            <if test="worksCount != null">works_count,</if>
            <if test="profileText != null">profile_text,</if>
            <if test="ipLocation != null">ip_location,</if>
            <if test="region != null">region,</if>
            <if test="touxiang != null">touxiang,</if>
            <if test="zhuye != null">zhuye,</if>
            <if test="commentText != null">comment_text,</if>
            <if test="replyTo != null">reply_to,</if>
            <if test="commentTime != null">comment_time,</if>
            <if test="status != null">status,</if>
            <if test="createTime != null">create_time,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="uid != null">#{uid},</if>
            <if test="userUid != null">#{userUid},</if>
            <if test="userDouyin != null">#{userDouyin},</if>
            <if test="nickname != null">#{nickname},</if>
            <if test="gender != null">#{gender},</if>
            <if test="age != null">#{age},</if>
            <if test="realName != null">#{realName},</if>
            <if test="signature != null">#{signature},</if>
            <if test="fansCount != null">#{fansCount},</if>
            <if test="followCount != null">#{followCount},</if>
            <if test="likesCount != null">#{likesCount},</if>
            <if test="worksCount != null">#{worksCount},</if>
            <if test="profileText != null">#{profileText},</if>
            <if test="ipLocation != null">#{ipLocation},</if>
            <if test="region != null">#{region},</if>
            <if test="touxiang != null">#{touxiang},</if>
            <if test="zhuye != null">#{zhuye},</if>
            <if test="commentText != null">#{commentText},</if>
            <if test="replyTo != null">#{replyTo},</if>
            <if test="commentTime != null">#{commentTime},</if>
            <if test="status != null">#{status},</if>
            <if test="createTime != null">#{createTime},</if>
         </trim>
    </insert>

    <update id="updateComment" parameterType="Comment">
        update comment
        <trim prefix="SET" suffixOverrides=",">
            <if test="uid != null">uid = #{uid},</if>
            <if test="userUid != null">user_uid = #{userUid},</if>
            <if test="nickname != null">nickname = #{nickname},</if>
            <if test="gender != null">gender = #{gender},</if>
            <if test="age != null">age = #{age},</if>
            <if test="realName != null">real_name = #{realName},</if>
            <if test="signature != null">signature = #{signature},</if>
            <if test="fansCount != null">fans_count = #{fansCount},</if>
            <if test="followCount != null">follow_count = #{followCount},</if>
            <if test="likesCount != null">likes_count = #{likesCount},</if>
            <if test="worksCount != null">works_count = #{worksCount},</if>
            <if test="profileText != null">profile_text = #{profileText},</if>
            <if test="ipLocation != null">ip_location = #{ipLocation},</if>
            <if test="region != null">region = #{region},</if>
            <if test="touxiang != null">touxiang = #{touxiang},</if>
            <if test="zhuye != null">zhuye = #{zhuye},</if>
            <if test="commentText != null">comment_text = #{commentText},</if>
            <if test="replyTo != null">reply_to = #{replyTo},</if>
            <if test="commentTime != null">comment_time = #{commentTime},</if>
            <if test="status != null">status = #{status},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="userDouyin != null">user_douyin = #{userDouyin},</if>
        </trim>
        where id = #{id}
    </update>
    <update id="updateCommentByUserId" parameterType="Comment">
        update comment
        <trim prefix="SET" suffixOverrides=",">
            <if test="status != null">status = #{status},</if>
        </trim>
        where user_uid = #{userUid}
    </update>

    <delete id="deleteCommentById" parameterType="Long">
        delete from comment where id = #{id}
    </delete>

    <delete id="deleteCommentByIds" parameterType="String">
        delete from comment where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>