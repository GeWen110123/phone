<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.phone.module.mapper.VideoTaskMapper">
    
    <resultMap type="VideoTask" id="VideoTaskResult">
        <result property="id"    column="id"    />
        <result property="taskName"    column="task_name"    />
        <result property="tags"    column="tags"    />
        <result property="douyinId"    column="douyin_id"    />
        <result property="remark"    column="remark"    />
        <result property="type"    column="type"    />
        <result property="devId"    column="dev_id"    />
        <result property="createTime"    column="create_time"    />
    </resultMap>

    <sql id="selectVideoTaskVo">
        select id, task_name, tags, douyin_id, remark,type, dev_id, create_time from video_task
    </sql>

    <select id="selectVideoTaskList" parameterType="VideoTask" resultMap="VideoTaskResult">
        <include refid="selectVideoTaskVo"/>
        <where>  
            <if test="taskName != null  and taskName != ''"> and task_name like concat('%', #{taskName}, '%')</if>
            <if test="tags != null  and tags != ''"> and tags = #{tags}</if>
            <if test="devId != null  and devId != ''"> and dev_id = #{devId}</if>
            <if test="type != null  and type != ''"> and type = #{type}</if>
            <if test="douyinId != null  and douyinId != ''"> and douyin_id = #{douyinId}</if>
        </where>
        order by create_time desc
    </select>
    
    <select id="selectVideoTaskById" parameterType="Long" resultMap="VideoTaskResult">
        <include refid="selectVideoTaskVo"/>
        where id = #{id}
    </select>
        
    <insert id="insertVideoTask" parameterType="VideoTask" useGeneratedKeys="true" keyProperty="id">
        insert into video_task
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="taskName != null">task_name,</if>
            <if test="tags != null">tags,</if>
            <if test="douyinId != null">douyin_id,</if>
            <if test="remark != null">remark,</if>
            <if test="type != null">type,</if>
            <if test="devId != null">dev_id,</if>
            <if test="createTime != null">create_time,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="taskName != null">#{taskName},</if>
            <if test="tags != null">#{tags},</if>
            <if test="douyinId != null">#{douyinId},</if>
            <if test="remark != null">#{remark},</if>
            <if test="type != null">#{type},</if>
            <if test="devId != null">#{devId},</if>
            <if test="createTime != null">#{createTime},</if>
         </trim>
    </insert>

    <update id="updateVideoTask" parameterType="VideoTask">
        update video_task
        <trim prefix="SET" suffixOverrides=",">
            <if test="taskName != null">task_name = #{taskName},</if>
            <if test="tags != null">tags = #{tags},</if>
            <if test="douyinId != null">douyin_id = #{douyinId},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="type != null">type = #{type},</if>
            <if test="devId != null">dev_id = #{devId},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteVideoTaskById" parameterType="Long">
        delete from video_task where id = #{id}
    </delete>

    <delete id="deleteVideoTaskByIds" parameterType="String">
        delete from video_task where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>